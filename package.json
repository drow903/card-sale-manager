{
  "name": "card-sale-manager",
  "version": "2.0.0",
  "description": "Local-first card sale workflow manager",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js && node --check features-v200.js && node --check media-tools.js && node --check live-popout.js && node --check live-popout-preload.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "blake3-wasm": "2.1.5",
    "ffmpeg-static": "5.2.0",
    "qrcode": "1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.drow903.cardsalemanager",
    "productName": "Card Sale Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "csm-files.js",
      "catalog-export.js",
      "cloudflare-pages.js",
      "license-service.js",
      "licensing-config.js",
      "media-tools.js",
      "preload.js",
      "live-popout-preload.js",
      "live-popout.js",
      "live-popout.html",
      "live-popout.css",
      "renderer.js",
      "features-v200.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "facebook-owner-companion/**/*",
      "node_modules/qrcode/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/blake3-wasm/**/*",
      "node_modules/dijkstrajs/**/*",
      "node_modules/pngjs/**/*",
      "node_modules/xlsx/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "extraResources": [
      {
        "from": "facebook-owner-companion",
        "to": "facebook-owner-companion",
        "filter": ["**/*"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "csm",
        "name": "Card Sale Manager Workspace",
        "description": "Portable Card Sale Manager workspace",
        "icon": "assets/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Card-Sale-Manager-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Card-Sale-Manager-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "drow903",
        "repo": "card-sale-manager"
      }
    ]
  }
}
