{
  "name": "card-sale-manager",
  "version": "0.1.0",
  "description": "Local-first card sale workflow manager",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js",
    "dist": "electron-builder --win portable"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.cardstitcher.salemanagement",
    "productName": "Card Sale Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "node_modules/xlsx/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "Card-Sale-Manager-${version}.exe"
    }
  }
}
