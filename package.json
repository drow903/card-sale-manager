{
  "name": "card-sale-manager",
  "version": "0.6.0",
  "description": "Local-first card sale workflow manager",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer.js",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.drow903.cardsalemanager",
    "productName": "Card Sale Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "node_modules/xlsx/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Card-Sale-Manager-${version}-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Card-Sale-Manager-${version}-Portable.${ext}"
    },
    "publish": [{
      "provider": "github",
      "owner": "drow903",
      "repo": "card-sale-manager"
    }]
  }
}
