{
  "manifest_version": 3,
  "name": "CSM Owner Facebook Companion",
  "version": "2.0.0",
  "description": "Owner-only, manual Facebook comment capture for Card Sale Manager.",
  "permissions": ["contextMenus", "storage", "activeTab"],
  "host_permissions": ["https://*.facebook.com/*", "http://127.0.0.1:43817/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://*.facebook.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "action": { "default_popup": "popup.html", "default_title": "CSM Owner Companion" }
}
